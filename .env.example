# データベース。空なら手元の data/pglite にPostgresの形で保存する（PGlite）。
# Neonを使うときは postgres:// から始まる接続先を入れる。
DATABASE_URL=

# 3社のAPIキー。空の編集者はモック（例の結果）で動く。
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# モデル名。空なら既定を使う。
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.7-flash
OPENAI_MODEL=gpt-5.6-luna

# 1にすると、キーがあってもAIを呼ばず例の結果を返す。
MOCK_EDITORS=

# 管理画面の合言葉
ADMIN_PASSWORD=change-me

# 公開先のURL。結果のURLと投稿文に使う。
APP_URL=http://localhost:3000
